# --- BTCTS NEXT: repo pollution prevention (authoritative) ---

# runtime / generated (never commit)
/data/
/logs/
/artifacts/
/backup/
/secrets/
/tmp/
/local/

# editor
/.vscode/

# python venv (repo root)
/.venv/
/venv/

# python caches
__pycache__/
*.py[cod]
*$py.class

# tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# build / packaging
build/
dist/
*.egg-info/
pip-wheel-metadata/

# archives (handoff zip etc.)
*.zip
*.7z
*.rar

# ---- handoff artifacts (NEXT canonical) ----
docs/handoff/
docs/handoff/**

# tmp is a workspace, never tracked
tmp/
tmp/**

# ops / service (do not commit)
service/
service/**

# logs
*.log
logs/

# --- gpt_room durable canonical memory allowlist ---
# tmp remains ignored except for the canonical project-memory files listed below.
# Root anchors are mandatory: nested workspaces such as btcts_next/tmp stay ignored.
!/tmp/
/tmp/*
!/tmp/gpt_room/
/tmp/gpt_room/*
!/tmp/gpt_room/02_START_HERE.md
!/tmp/gpt_room/08_STATUS.md
!/tmp/gpt_room/09_FOCUS.json
!/tmp/gpt_room/10_DECISIONS.md
!/tmp/gpt_room/11_STATE.json
!/tmp/gpt_room/CURRENT.json
!/tmp/gpt_room/DECISIONS.md
!/tmp/gpt_room/ENVIRONMENT_GUARDS.md
!/tmp/gpt_room/OBSERVATION_CONTROL.md
!/tmp/gpt_room/POLICY.md
!/tmp/gpt_room/START.md
