# --- BTCTS NEXT: repo pollution prevention (authoritative) ---

# runtime / generated (never commit)
/data/
/logs/
/artifacts/
/backup/
/secrets/
/tmp/
/local/

# editor
/.vscode/

# python venv (repo root)
/.venv/
/venv/

# python caches
__pycache__/
*.py[cod]
*$py.class

# tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# build / packaging
build/
dist/
*.egg-info/
pip-wheel-metadata/

# archives (handoff zip etc.)
*.zip
*.7z
*.rar

# ---- handoff artifacts (NEXT canonical) ----
docs/handoff/
docs/handoff/**

# tmp is a workspace, never tracked
tmp/
tmp/**
