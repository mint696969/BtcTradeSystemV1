# path: btc_trade_system/config/ui/tabs_def.yaml
# desc: ダッシュボード／設定タブの既定定義（正準）。settings_hub は本定義を単一ソースとして参照する。

# 表示順（左→右）。main は最左固定、basic は最右固定、collector は basic の左に固定。
order: [main, health, audit, collector, basic]

# 有効・無効
enabled:
  main: true
  health: true
  audit: true
  collector: true # ダッシュボードは持たないが「設定タブ」に出すため定義
  basic: true # 初期設定（設定タブのみ）

# 表示ラベル（UIに出す名前）
labels:
  main: メイン
  health: 健全性
  audit: 開発監査
  collector: コレクター
  basic: 初期設定

# 起動時の初期タブ（ダッシュボード側で使用、未使用でも維持）
initial: main
